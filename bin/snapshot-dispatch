#!/bin/bash
# snapshot-dispatch — forced-command dispatcher for the agent-snapshot
# localhost SSH key.
#
# WHY THIS EXISTS
#   macOS TCC blocks a launchd-spawned process from reading protected folders
#   (Desktop, Documents, removable volumes). A LaunchAgent running /bin/bash
#   gets "Operation not permitted" on ls/open/rsync against ~/Desktop while
#   ~/Library reads fine. If your backup SOURCE lives in a protected folder,
#   scheduled jobs can never work when launchd invokes bash directly.
#   sshd DOES hold the necessary access (grant it Full Disk Access once), so
#   the LaunchAgents ssh to localhost with a dedicated key whose forced
#   command is this file. The backup therefore executes as a child of sshd
#   and can read the source. The same pattern runs the replica job on the
#   archive host, where launchd cannot open USB volumes.
#
# CONTRACT
#   The key's authorized_keys entry pins command="/bin/bash <this file>", so a
#   client holding the key CANNOT choose what runs. The requested MODE arrives
#   in SSH_ORIGINAL_COMMAND and is matched against the closed allowlist below.
#   Anything else is refused. This is also a data-safety property: even a fully
#   compromised process holding this key can only trigger a backup or a
#   read-only probe — never a delete, never an arbitrary command.
#
# MODES
#   snap       -> snapshot snap    (hardlink snapshot to the archive host DAS)
#   vault      -> snapshot vault   (compressed archive to the vault host)
#   both       -> snapshot both
#   probe      -> READ-ONLY operational health check (source, rsync, archive/vault).
#   probe-auth -> READ-ONLY auth gate only: sshd accepted this key and ran this script.
#                 No conf, no external deps — for key rotation cutover verification.
#
set -uo pipefail

# sshd hands out a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin) with no Homebrew,
# but the vault leg needs zstd. Supply it here; launchd EnvironmentVariables
# do not reach jobs routed through sshd.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

APPDIR="$HOME/Library/Application Support/agent-snapshot"
BIN="$APPDIR/bin/snapshot"
CONF="$APPDIR/conf/snapshot.conf"
LOGDIR="$HOME/Library/Logs/agent-snapshot"
mkdir -p "$LOGDIR"
DLOG="$LOGDIR/dispatch.log"

DISPATCH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KEY_LIB="$DISPATCH_DIR/snapshot-key-lib.sh"
if [ ! -r "$KEY_LIB" ]; then
  echo "snapshot-dispatch: missing rate-limit library $KEY_LIB" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$KEY_LIB"

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$DLOG"; }

_emit_rate_deny() {
  local mode=$1 deny_json=$2
  local reason burst_count sustain_count retry_after_ts retry_when limit_desc
  local deny_fields
  deny_fields=$(/usr/bin/python3 - "$deny_json" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        d = json.load(fh)
except (IOError, OSError, ValueError):
    sys.exit(1)
print("\t".join([
    str(d.get("reason", "unknown")),
    str(d.get("burst_count", "?")),
    str(d.get("sustain_count", "?")),
    str(d.get("retry_after_ts", 0)),
]))
PY
) || {
    log "DENIED mode=$mode reason=unknown (could not read $deny_json)"
    echo "snapshot-dispatch: rate limit denied for mode '$mode' (details unavailable)" >&2
    return
  }
  IFS=$'\t' read -r reason burst_count sustain_count retry_after_ts <<< "$deny_fields"
  retry_when=$(date -r "$retry_after_ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "epoch $retry_after_ts")
  case "$reason" in
    burst)
      limit_desc="${SNAP_RATE_BURST_COUNT} per ${SNAP_RATE_BURST_WINDOW_SEC}s burst window"
      ;;
    sustain)
      limit_desc="${SNAP_RATE_SUSTAIN_COUNT} per ${SNAP_RATE_SUSTAIN_WINDOW_SEC}s sustain window"
      ;;
    *)
      limit_desc="$reason"
      ;;
  esac
  log "DENIED mode=$mode reason=$reason burst_count=$burst_count sustain_count=$sustain_count client=[${SSH_CLIENT:-none}] retry_after=$retry_when"
  echo "snapshot-dispatch: rate limit denied for mode '$mode': $reason limit ($limit_desc) reached (burst_count=$burst_count sustain_count=$sustain_count); retry after $retry_when" >&2
}

MODE="${SSH_ORIGINAL_COMMAND:-}"
log "request mode=[$MODE] client=[${SSH_CLIENT:-none}] pid=$$"

case "$MODE" in
  snap|vault|both)
    # snap|vault|both need STAGE (busy lock) and rate thresholds from conf — probe
    # sources conf separately with its own error text; do not share that path.
    # shellcheck disable=SC1090
    source "$CONF" 2>/dev/null || {
      log "FAIL cannot read $CONF"
      echo "snapshot-dispatch: cannot read config $CONF" >&2
      exit 1
    }
    if [ -z "${STAGE:-}" ]; then
      log "FAIL STAGE unset after sourcing $CONF"
      echo "snapshot-dispatch: STAGE unset in $CONF" >&2
      exit 1
    fi
    # Brief defaults (IMPLEMENTATION-BRIEF.md) — never run unlimited on missing thresholds.
    SNAP_RATE_BURST_COUNT=${SNAP_RATE_BURST_COUNT:-3}
    SNAP_RATE_BURST_WINDOW_SEC=${SNAP_RATE_BURST_WINDOW_SEC:-600}
    SNAP_RATE_SUSTAIN_COUNT=${SNAP_RATE_SUSTAIN_COUNT:-2}
    SNAP_RATE_SUSTAIN_WINDOW_SEC=${SNAP_RATE_SUSTAIN_WINDOW_SEC:-3600}

    STATE_DIR="$(asnap_state_dir)"
    HISTORY="$STATE_DIR/trigger-history.json"
    HISTORY_LOCK="$STATE_DIR/trigger-history.lockdir"
    DENY_JSON="$STATE_DIR/last-rate-limit.json"
    BUSY_LOCK="$STAGE/.lock"

    asnap_admit "$HISTORY" "$HISTORY_LOCK" "$BUSY_LOCK" "source-forced" "$MODE" \
      "${SSH_CLIENT:-}" \
      "$SNAP_RATE_BURST_COUNT" "$SNAP_RATE_BURST_WINDOW_SEC" \
      "$SNAP_RATE_SUSTAIN_COUNT" "$SNAP_RATE_SUSTAIN_WINDOW_SEC" \
      "$DENY_JSON"
    admit_rc=$?
    if [ "$admit_rc" -eq 79 ]; then
      log "BUSY mode=$MODE client=[${SSH_CLIENT:-none}] lock=$BUSY_LOCK"
      echo "snapshot-dispatch: snapshot already running (lock $BUSY_LOCK); try again later" >&2
      exit 79
    fi
    if [ "$admit_rc" -eq 78 ]; then
      _emit_rate_deny "$MODE" "$DENY_JSON"
      exit 78
    fi
    if [ "$admit_rc" -ne 0 ]; then
      log "FAIL asnap_admit rc=$admit_rc mode=$MODE"
      echo "snapshot-dispatch: rate-limit admission failed (rc=$admit_rc)" >&2
      exit 1
    fi

    log "-> exec snapshot $MODE"
    exec /bin/bash "$BIN" "$MODE"
    ;;
  probe)
    # Read-only. Proves the scheduled transport can actually reach the backup
    # SOURCE. Touches nothing, transfers nothing, writes no snapshot.
    # shellcheck disable=SC1090
    source "$CONF" 2>/dev/null || { echo "probe: FAIL cannot read $CONF"; exit 1; }
    SRC="$SOURCE"
    rc_all=0
    echo "probe: host=$(hostname -s) uid=$(id -u) parent=$(ps -o comm= -p $PPID 2>/dev/null | tr -d ' ')"
    echo "probe: PATH=$PATH"
    echo "probe: zstd=$(command -v zstd || echo MISSING)"

    if ls "$SRC" >/dev/null 2>&1; then
      echo "probe: T1 readdir $SRC = OK ($(ls "$SRC" | wc -l | tr -d ' ') entries)"
    else
      echo "probe: T1 readdir $SRC = FAIL [$(ls "$SRC" 2>&1 | head -1)]"; rc_all=1
    fi

    PROBE_FILE="$(find "$SRC" -maxdepth 2 -type f -print 2>/dev/null | head -1)"
    if [ -n "$PROBE_FILE" ] && head -c 32 "$PROBE_FILE" >/dev/null 2>&1; then
      echo "probe: T2 open file under $SRC = OK"
    else
      echo "probe: T2 open file under $SRC = FAIL"; rc_all=1
    fi

    # Same reader the real job uses, in dry-run mode (-n writes nothing).
    PROBE_DIR="${PROBE_FILE:+$(dirname "$PROBE_FILE")}"
    ro=$(/usr/bin/rsync -rn "${PROBE_DIR:-$SRC}/" "$HOME/Library/Caches/agent-snapshot/.probe-dryrun/" 2>&1)
    if echo "$ro" | grep -qi "not permitted"; then
      echo "probe: T3 rsync dry-run read of $SRC = FAIL [$(echo "$ro" | head -1)]"; rc_all=1
    else
      echo "probe: T3 rsync dry-run read of $SRC = OK"
    fi

    # Reachability of the enabled targets, no data moved.
    if [ "${SNAP_ENABLED:-false}" = true ]; then
      if ssh $SSH_OPTS "$SNAP_SSH" 'exit 0' >/dev/null 2>&1; then
        echo "probe: T4 archive host reachable = OK"
      else
        echo "probe: T4 archive host reachable = FAIL"; rc_all=1
      fi
    fi
    if [ "${VAULT_ENABLED:-false}" = true ]; then
      if ssh $SSH_OPTS "$VAULT_SSH" 'exit 0' >/dev/null 2>&1; then
        echo "probe: T5 vault host reachable = OK"
      else
        echo "probe: T5 vault host reachable = FAIL"; rc_all=1
      fi
    fi

    log "probe finished rc=$rc_all"
    echo "probe: OVERALL rc=$rc_all"
    exit $rc_all
    ;;
  probe-auth)
    # Auth-only cutover gate: proves forced-command dispatch, nothing else.
    echo "probe-auth: OK role=writer host=$(hostname -s)"
    log "probe-auth OK role=writer host=$(hostname -s)"
    exit 0
    ;;
  *)
    log "REFUSED unknown mode [$MODE]"
    echo "snapshot-dispatch: refused (allowed: snap | vault | both | probe)" >&2
    exit 77
    ;;
esac
