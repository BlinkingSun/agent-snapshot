#!/bin/bash
# snapshot — agent-snapshot writer: backs up SOURCE to the archive host (snap
# leg) and/or a second host (vault leg).
#
#   snapshot            both enabled legs (on-demand)
#   snapshot snap       rsync hardlink snapshot -> archive host DAS
#   snapshot vault      compressed dated archive -> vault host
#
# Retention is per-leg: SNAP_RETENTION days of snapshots; the vault keeps the
# newest VAULT_KEEP archives (by name) or, with VAULT_KEEP unset/0,
# VAULT_RETENTION days of them.
# An unreachable target is reported and skipped, never treated as success.
#
# Exit codes: 0 every requested leg OK · 1 a leg failed or was skipped ·
# 75 bounced because that leg is already running (slot NOT taken).

set -uo pipefail

# macOS launchd cannot execute scripts that live inside TCC-protected folders.
# Scheduled jobs run the installed copy under ~/Library/Application Support.
# This flag only proves that copy is reachable from launchd — it backs up nothing.
if [ "${1-}" = "--launchd-ok" ]; then
  mkdir -p "$HOME/Library/Logs/agent-snapshot"
  echo "$(date '+%Y-%m-%d %H:%M:%S')  launchd-ok pid=$$" >> "$HOME/Library/Logs/agent-snapshot/launchd-ok.log"
  exit 0
fi

CONF="${AGENT_SNAPSHOT_CONF:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/conf/snapshot.conf}"
[ -f "$CONF" ] || { echo "snapshot: config not found: $CONF (copy conf/snapshot.conf.example)" >&2; exit 1; }
# shellcheck disable=SC1090
source "$CONF"

STAMP="$(date +%Y-%m-%d_%H%M%S)"
LOG="$LOGDIR/$(date +%Y-%m).log"
mkdir -p "$LOGDIR" "$STAGE"

RC=0
declare -a RESULTS=()

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG"; }
die() { log "FATAL: $*"; exit 1; }

# Per-leg lock. One global lock made back-to-back schedules contend: once a
# long vault archive outgrew the gap before the next snap slot, that snap run
# bounced. The legs are independent readers of $SOURCE, so each locks its own
# stage subdir ($STAGE/snap, $STAGE/vault); TARGET=both holds BOTH, so a
# scheduled run still can't collide with an on-demand one. macOS has no
# flock(1) — the PID file is the operative lock (snapshot-dispatch and
# snapshot-key-rotate probe the same files). A bounce exits 75 (EX_TEMPFAIL),
# not 0: a skipped slot must surface in launchctl, not read as success.
TARGET="${1:-both}"
STAGE_BASE="$STAGE"
case "$TARGET" in
  snap|vault) LOCK_DIRS=("$STAGE_BASE/$TARGET") ;;
  both)       LOCK_DIRS=("$STAGE_BASE/snap" "$STAGE_BASE/vault") ;;
  *)          die "unknown target '$TARGET' (use: snap | vault | both)" ;;
esac
mkdir -p "${LOCK_DIRS[@]}"
for _ld in "${LOCK_DIRS[@]}"; do
  if [ -f "$_ld/.pid" ] && kill -0 "$(cat "$_ld/.pid" 2>/dev/null)" 2>/dev/null; then
    log "another snapshot run is already active (pid $(cat "$_ld/.pid"), lock $_ld) — exiting 75"
    exit 75
  fi
done
for _ld in "${LOCK_DIRS[@]}"; do echo $$ > "$_ld/.pid"; done
trap 'for _ld in "${LOCK_DIRS[@]}"; do rm -f "$_ld/.pid"; done' EXIT

[ -d "$SOURCE" ] || die "source $SOURCE does not exist"

# Build rsync/tar exclude arguments from the configured list.
RSYNC_EX=(); TAR_EX=()
for e in "${EXCLUDES[@]}"; do
  RSYNC_EX+=(--exclude "$e")
  TAR_EX+=(--exclude "$e")
done

reachable() {  # reachable <ssh-target>
  ssh $SSH_OPTS "$1" 'exit 0' >/dev/null 2>&1
}

# Remote path for SNAP_DIR: absolute stays absolute; relative is left bare,
# which ssh, rsync and scp all resolve against the remote $HOME. Never prefix
# "~/" — every remote command single-quotes the path, so the tilde would not
# expand and a literal "~" directory would be created instead.
snap_path() {
  printf '%s' "${SNAP_DIR#\~/}"
}

# Free space on the *destination volume* (the DAS, not the archive host's boot disk).
snap_free_gb() {
  local path out
  path="$(snap_path)"
  out=$(ssh $SSH_OPTS "$SNAP_SSH" "df -g '$path' 2>/dev/null | awk 'NR==2{print \$4}'" | head -1 | tr -dc "0-9")
  echo "${out:-0}"
}

# --- change-manifest sidecar (opt-in: SNAP_CHANGE_SIDECAR=true) -------------
# After a successful snap rsync, publish <rdir>/.changes/<stamp>.json
# {schema,stamp,base,changed[],files,bytes,complete} as the hook for an
# archive-side fast replica path. The bundled engine does NOT consume it (see
# archive-host/SEMANTICS.md (g)); it is off by default because measuring
# files/bytes walks the whole new snapshot on the archive host. changed[] = every path rsync re-copied vs the link-dest
# base — content OR metadata differences (GNU itemize; \#ooo escapes in names
# are decoded). Deletions are NOT listed: the engine derives them from its own
# walk. files/bytes = whole-snapshot regular-file count and logical byte sum,
# measured remotely after the rsync. A consumer must treat a missing or invalid
# sidecar as "do a full pass", so every failure here is deliberately NON-FATAL. Baseline runs (no link-dest base) publish nothing.
write_snap_change_sidecar() {  # <rdir> <base-stamp> <itemize-capture-file>
  local rdir=$1 base=$2 cap=$3
  local tmp="$STAGE_BASE/snap/$STAMP.sidecar.json"
  local counts files bytes
  counts=$(ssh $SSH_OPTS "$SNAP_SSH" "cd '$rdir/$STAMP' 2>/dev/null && find . -type f -print0 | xargs -0 stat -f %z 2>/dev/null | awk '{n++; s+=\$1} END{printf \"%d %d\", n, s}'") || return 1
  files=${counts% *}; bytes=${counts#* }
  [ -n "$files" ] && [ -n "$bytes" ] || return 1
  /usr/bin/python3 - "$cap" "$STAMP" "$base" "$files" "$bytes" >"$tmp" <<'PY' || return 1
import json, re, sys
cap, stamp, base, files, nbytes = sys.argv[1:6]
def unescape(name):
    # GNU rsync emits control chars in names as \#ooo octal escapes.
    return re.sub(r'\\#([0-7]{3})', lambda m: chr(int(m.group(1), 8)), name)
changed = []
with open(cap, 'r', encoding='utf-8', errors='surrogateescape') as fh:
    for line in fh:
        if not line.startswith('CHG|'):
            continue
        _, itemize, name = line.rstrip('\n').split('|', 2)
        # Regular files and symlinks only. Directories are engine-derived,
        # and '*deleting' has 'd' in the type position, so both fall out.
        if len(itemize) > 1 and itemize[1] in ('f', 'L'):
            changed.append(unescape(name))
json.dump({"schema": 1, "stamp": stamp, "base": base,
           "changed": changed, "files": int(files),
           "bytes": int(nbytes), "complete": True},
          sys.stdout, ensure_ascii=False)
PY
  ssh $SSH_OPTS "$SNAP_SSH" "mkdir -p '$rdir/.changes'" || return 1
  # tmp INSIDE .changes (a stamp-shaped name in SNAP_DIR could be discovered
  # as a snapshot), then same-directory rename = atomic publish; last write
  # wins on a rerun of the same stamp.
  scp -q $SSH_OPTS "$tmp" "$SNAP_SSH:$rdir/.changes/.tmp-$STAMP.json" || return 1
  ssh $SSH_OPTS "$SNAP_SSH" "mv -f '$rdir/.changes/.tmp-$STAMP.json' '$rdir/.changes/$STAMP.json'" || return 1
  rm -f "$tmp"
  return 0
}

# ---------------------------------------------------------------- snap ------
backup_snap() {
  local rdir
  rdir="$(snap_path)"
  log "[snap] starting -> $SNAP_SSH:$rdir/$STAMP"

  # Host is picked ONCE here and every later ssh/rsync/scp reuses $SNAP_SSH,
  # so a mid-run name-resolution blip (mDNS .local names drop out) can't strand
  # the post-rsync finalize, sidecar and kick steps.
  if ! reachable "$SNAP_SSH"; then
    if [ -n "${SNAP_SSH_FALLBACK:-}" ] && reachable "$SNAP_SSH_FALLBACK"; then
      log "[snap] WARN $SNAP_SSH unreachable — using fallback $SNAP_SSH_FALLBACK for this run (address changed?)"
      SNAP_SSH="$SNAP_SSH_FALLBACK"
    else
      log "[snap] UNREACHABLE ($SNAP_SSH${SNAP_SSH_FALLBACK:+, $SNAP_SSH_FALLBACK}) — skipped"
      RESULTS+=("snap: SKIPPED (unreachable)"); RC=1; return 1
    fi
  fi

  ssh $SSH_OPTS "$SNAP_SSH" "mkdir -p '$rdir'" || {
    log "[snap] could not create remote dir"; RESULTS+=("snap: FAILED (mkdir)"); RC=1; return 1; }

  local freegb
  freegb=$(snap_free_gb)
  log "[snap] free space: ${freegb}G (floor ${SNAP_MIN_FREE_GB}G)"
  if [ "${freegb:-0}" -lt "$SNAP_MIN_FREE_GB" ]; then
    log "[snap] below floor — pruning oldest snapshots to make room"
    prune_snap_to_fit
    freegb=$(snap_free_gb)
    if [ "${freegb:-0}" -lt "$SNAP_MIN_FREE_GB" ]; then
      log "[snap] STILL below floor (${freegb}G) — aborting"
      RESULTS+=("snap: FAILED (low disk ${freegb}G)"); RC=1; return 1
    fi
  fi

  # Newest existing snapshot becomes the hardlink base, so unchanged files cost nothing.
  local prev
  prev=$(ssh $SSH_OPTS "$SNAP_SSH" "ls -1 '$rdir' 2>/dev/null | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}_' | sort | tail -1")
  local linkdest=()
  if [ -n "$prev" ]; then
    linkdest=(--link-dest="../$prev")
    log "[snap] hardlinking unchanged files against $prev"
  else
    log "[snap] no previous snapshot — this is a full baseline"
  fi

  # -rlptD rather than -a: skips owner/group, which usually differ between the
  # two machines. --delete acts only INSIDE the brand-new dated directory being
  # built; it never touches previous snapshots (see docs/SAFETY.md).
  # Remote rsync + --link-dest on a large tree can exhaust default fds
  # ("Too many open files") and stall. Raise the remote limit for the server.
  # With the sidecar enabled, GNU rsync itemizes exactly what it re-copies vs
  # the link-dest base — the sidecar source. openrsync (macOS /usr/bin/rsync)
  # has no such out-format semantics: no capture, no sidecar. Detected by
  # version string, not path.
  local rsync_gnu=0 chgcap="" rc
  if [ "${SNAP_CHANGE_SIDECAR:-false}" = true ]; then
    rsync_gnu=1
    case "$(rsync --version 2>/dev/null | head -1)" in
      *openrsync*) rsync_gnu=0 ;;
    esac
  fi
  if [ "$rsync_gnu" -eq 1 ]; then
    chgcap="$STAGE_BASE/snap/$STAMP.itemize"
    rsync -rlptD --delete ${linkdest[@]+"${linkdest[@]}"} ${RSYNC_EX[@]+"${RSYNC_EX[@]}"} \
          --out-format='CHG|%i|%n' \
          -e "ssh $SSH_OPTS" \
          --rsync-path='ulimit -n 65535; rsync' \
          "$SOURCE/" "$SNAP_SSH:$rdir/$STAMP/" >"$chgcap" 2>>"$LOG"
    rc=$?
    log "[snap] itemized $(grep -c '^CHG|' "$chgcap" 2>/dev/null || echo 0) changed paths"
  else
    rsync -rlptD --delete ${linkdest[@]+"${linkdest[@]}"} ${RSYNC_EX[@]+"${RSYNC_EX[@]}"} \
          -e "ssh $SSH_OPTS" \
          --rsync-path='ulimit -n 65535; rsync' \
          "$SOURCE/" "$SNAP_SSH:$rdir/$STAMP/" >>"$LOG" 2>&1
    rc=$?
  fi
  # 24 = "file vanished during transfer", benign on a live working directory.
  if [ $rc -ne 0 ] && [ $rc -ne 24 ]; then
    log "[snap] rsync FAILED (rc=$rc)"; RESULTS+=("snap: FAILED (rsync rc=$rc)"); RC=1
    [ -n "$chgcap" ] && rm -f "$chgcap"
    return 1
  fi
  [ $rc -eq 24 ] && log "[snap] note: some files vanished mid-transfer (rc=24, benign)"

  # Finalize = promote $STAMP to `latest`. FATAL: a run whose rsync finished
  # but whose promote ssh was lost to a resolver dropout used to log OK, and
  # the archive engine rightly flagged the never-promoted stamp a corpse (P12).
  # Retried so a transient blip doesn't throw away a long rsync; verified by
  # reading the link back rather than trusting ssh's exit code alone.
  local fin_ok=0 attempt
  for attempt in 1 2 3; do
    if ssh $SSH_OPTS "$SNAP_SSH" "cd '$rdir' && rm -f latest && ln -s '$STAMP' latest && [ \"\$(readlink latest)\" = '$STAMP' ]"; then
      fin_ok=1; break
    fi
    log "[snap] finalize attempt $attempt/3 failed (latest -> $STAMP)"
    [ "$attempt" -lt 3 ] && sleep 30
  done
  if [ "$fin_ok" -ne 1 ]; then
    log "[snap] finalize FAILED — latest NOT moved to $STAMP; snapshot unpromoted"
    RESULTS+=("snap: FAILED (finalize: latest not updated)"); RC=1
    [ -n "$chgcap" ] && rm -f "$chgcap"
    return 1
  fi

  local size
  size=$(ssh $SSH_OPTS "$SNAP_SSH" "du -sh '$rdir'/'$STAMP' 2>/dev/null | cut -f1")
  log "[snap] OK — snapshot $STAMP (${size:-size unknown} logical)"
  RESULTS+=("snap: OK ($STAMP, ${size:-size unknown})")
  # Sidecar BEFORE the replica kick below, so a kicked replica pass could
  # already use it. Strictly after the successful rsync (staleness defense:
  # a rerun of the same stamp rewrites it, last write wins).
  if [ "$rsync_gnu" -eq 1 ] && [ -n "$prev" ]; then
    if write_snap_change_sidecar "$rdir" "$prev" "$chgcap"; then
      log "[snap] change sidecar published (.changes/$STAMP.json)"
    else
      log "[snap] change sidecar FAILED (non-fatal)"
    fi
  elif [ "${SNAP_CHANGE_SIDECAR:-false}" != true ]; then
    :   # sidecar disabled (default)
  elif [ -z "$prev" ]; then
    log "[snap] baseline run — no change sidecar"
  else
    log "[snap] openrsync in PATH — no change sidecar"
  fi
  [ -n "$chgcap" ] && rm -f "$chgcap"
  prune_snap
  # The archive host owns the replica (primary DAS -> mirror DAS). Kick it so the
  # copy starts now rather than at the host's next scheduled pass. Do not wait —
  # a volume replica can outlive this run's lock.
  if [ -n "${REPLICA_KICK:-}" ]; then
    if ssh $SSH_OPTS "$SNAP_SSH" "$REPLICA_KICK"; then
      log "[snap] replica pass started on archive host"
    else
      log "[snap] replica kick FAILED — snapshot is still good; archive host schedule will retry"
    fi
  fi
  return 0
}

prune_snap() {
  local rdir removed
  rdir="$(snap_path)"
  removed=$(ssh $SSH_OPTS "$SNAP_SSH" "
    cd '$rdir' 2>/dev/null || exit 0
    n=0
    for d in \$(ls -1 | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}_' | sort); do
      day=\${d%%_*}
      age=\$(( ( \$(date +%s) - \$(date -j -f %Y-%m-%d \"\$day\" +%s 2>/dev/null || date -d \"\$day\" +%s 2>/dev/null || echo \$(date +%s)) ) / 86400 ))
      if [ \"\$age\" -gt $SNAP_RETENTION ]; then rm -rf \"\$d\"; echo \"\$d\"; n=\$((n+1)); fi
    done
    # the writer owns .changes/: drop sidecars whose snapshot is gone (the
    # archive engine is forbidden from deleting primary content)
    if cd .changes 2>/dev/null; then   # cwd is already \$rdir
      for j in *.json; do
        [ -e \"\$j\" ] || continue
        s=\${j%.json}
        [ -d \"../\$s\" ] || rm -f -- \"\$j\"
      done
    fi")
  if [ -n "$removed" ]; then
    log "[snap] pruned (older than ${SNAP_RETENTION}d): $(echo "$removed" | tr '\n' ' ')"
  else
    log "[snap] nothing to prune"
  fi
}

prune_snap_to_fit() {
  local rdir
  rdir="$(snap_path)"
  ssh $SSH_OPTS "$SNAP_SSH" "
    cd '$rdir' 2>/dev/null || exit 0
    list=\$(ls -1 | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}_' | sort)
    count=\$(echo \"\$list\" | grep -c .)
    if [ \"\$count\" -gt 1 ]; then rm -rf \"\$(echo \"\$list\" | head -1)\"; fi
    if cd .changes 2>/dev/null; then   # cwd is already \$rdir
      for j in *.json; do
        [ -e \"\$j\" ] || continue
        s=\${j%.json}
        [ -d \"../\$s\" ] || rm -f -- \"\$j\"
      done
    fi"
}

# ---------------------------------------------------------------- vault -----
win_path() { printf '%s' "${VAULT_DIR//\//\\}"; }

backup_vault() {
  local archive="$STAGE_BASE/vault/$STAMP.tar.zst"
  log "[vault] starting -> $VAULT_SSH:$VAULT_DIR/$STAMP.tar.zst"

  if ! reachable "$VAULT_SSH"; then
    log "[vault] UNREACHABLE ($VAULT_SSH) — skipped"
    RESULTS+=("vault: SKIPPED (unreachable)"); RC=1; return 1
  fi

  log "[vault] compressing $SOURCE ..."
  tar ${TAR_EX[@]+"${TAR_EX[@]}"} -C "$(dirname "$SOURCE")" -cf - "$(basename "$SOURCE")" 2>>"$LOG" \
    | zstd -T0 -3 -q -o "$archive" 2>>"$LOG"
  local prc=$?
  # Non-empty is not enough: a truncated tar still has bytes and would hash-match
  # on transfer, producing a silently corrupt backup. Fail on any pipeline error...
  if [ $prc -ne 0 ] || [ ! -s "$archive" ]; then
    log "[vault] archive creation FAILED (pipeline rc=$prc)"
    RESULTS+=("vault: FAILED (tar/zstd rc=$prc)"); RC=1
    rm -f "$archive"; return 1
  fi
  # ...and prove the archive decompresses cleanly before we ship it anywhere.
  if ! zstd -t -q "$archive" 2>>"$LOG"; then
    log "[vault] archive FAILED integrity test — not transferring"
    RESULTS+=("vault: FAILED (corrupt archive)"); RC=1
    rm -f "$archive"; return 1
  fi
  log "[vault] archive integrity verified"
  local human
  human=$(du -h "$archive" | cut -f1)
  log "[vault] archive built: $human"

  local localhash
  localhash=$(shasum -a 256 "$archive" | awk '{print $1}')

  if [ "$VAULT_OS" = "windows" ]; then
    ssh $SSH_OPTS "$VAULT_SSH" "if not exist \"$(win_path)\" mkdir \"$(win_path)\"" >/dev/null 2>&1
  else
    ssh $SSH_OPTS "$VAULT_SSH" "mkdir -p '$VAULT_DIR'" >/dev/null 2>&1
  fi

  # Free-space guard (set VAULT_MIN_FREE_GB to enable): the destination needs
  # room for this archive plus VAULT_MIN_FREE_GB left over — essential when
  # the vault directory sits on the host's OS drive. A missing, locked or
  # unmounted drive reads as "unknown" and fails here with a clear reason,
  # instead of an opaque scp "dest open ... Failure".
  if [ -n "${VAULT_MIN_FREE_GB:-}" ]; then
    local where freegb needgb
    if [ "$VAULT_OS" = "windows" ]; then
      where="${VAULT_DIR%%:*}:"   # VAULT_DIR must start with a drive letter, e.g. E:/agent-snapshot
      freegb=$(ssh $SSH_OPTS "$VAULT_SSH" "powershell -NoProfile -Command \"[math]::Floor((Get-PSDrive ${where%:}).Free/1GB)\"" 2>/dev/null | tr -dc '0-9')
    else
      where="$VAULT_DIR"
      freegb=$(ssh $SSH_OPTS "$VAULT_SSH" "df -Pk '$VAULT_DIR' 2>/dev/null | awk 'NR==2{print int(\$4/1048576)}'" 2>/dev/null | tr -dc '0-9')
    fi
    needgb=$(( $(stat -f %z "$archive") / 1073741824 + 1 + VAULT_MIN_FREE_GB ))
    if [ -z "$freegb" ] || [ "$freegb" -lt "$needgb" ]; then
      log "[vault] $where has ${freegb:-unknown}G free, need ${needgb}G (archive + ${VAULT_MIN_FREE_GB}G floor) — not transferring"
      RESULTS+=("vault: FAILED ($where ${freegb:-unavailable}G free, need ${needgb}G)"); RC=1
      rm -f "$archive"; return 1
    fi
    log "[vault] $where ${freegb}G free, need ${needgb}G — ok"
  fi

  log "[vault] transferring ..."
  if ! scp -q $SSH_OPTS "$archive" "$VAULT_SSH:$VAULT_DIR/$STAMP.tar.zst" 2>>"$LOG"; then
    log "[vault] transfer FAILED"; RESULTS+=("vault: FAILED (scp)"); RC=1; rm -f "$archive"; return 1
  fi

  # Verify the bytes that landed match what we sent, then drop the local copy.
  local remotehash
  if [ "$VAULT_OS" = "windows" ]; then
    remotehash=$(ssh $SSH_OPTS "$VAULT_SSH" "certutil -hashfile \"$(win_path)\\$STAMP.tar.zst\" SHA256" 2>/dev/null \
                 | sed -n '2p' | tr -d ' \r\n')
  else
    remotehash=$(ssh $SSH_OPTS "$VAULT_SSH" "(sha256sum '$VAULT_DIR/$STAMP.tar.zst' 2>/dev/null || shasum -a 256 '$VAULT_DIR/$STAMP.tar.zst') | awk '{print \$1}'" | tr -d ' \r\n')
  fi
  if [ "$localhash" != "$remotehash" ]; then
    log "[vault] CHECKSUM MISMATCH — local=$localhash remote=$remotehash"
    RESULTS+=("vault: FAILED (checksum)"); RC=1; rm -f "$archive"; return 1
  fi
  log "[vault] verified sha256=${localhash:0:16}…"
  rm -f "$archive"

  log "[vault] OK — archive $STAMP.tar.zst ($human)"
  RESULTS+=("vault: OK ($STAMP.tar.zst, $human)")
  prune_vault
  return 0
}

prune_vault() {
  local removed
  # Count-based when VAULT_KEEP > 0: keep the newest N archives, delete the
  # rest. Sorted by NAME — the dated stamps sort chronologically and can't be
  # fooled by a touched mtime the way age-by-LastWriteTime/-mtime can. Disk
  # use is also predictable: the upload briefly holds VAULT_KEEP+1 archives.
  if [ "${VAULT_KEEP:-0}" -gt 0 ]; then
    if [ "$VAULT_OS" = "windows" ]; then
      removed=$(ssh $SSH_OPTS "$VAULT_SSH" "powershell -NoProfile -Command \"Get-ChildItem '$(win_path)\\*.tar.zst' | Sort-Object Name -Descending | Select-Object -Skip $VAULT_KEEP | ForEach-Object { \$_.Name; Remove-Item \$_.FullName -Force }\"" 2>/dev/null | tr -d '\r')
    else
      removed=$(ssh $SSH_OPTS "$VAULT_SSH" "cd '$VAULT_DIR' 2>/dev/null && ls -1 | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}\.tar\.zst\$' | sort -r | tail -n +$((VAULT_KEEP + 1)) | while read -r f; do rm -f -- \"\$f\" && echo \"\$f\"; done" 2>/dev/null)
    fi
    if [ -n "$removed" ]; then
      log "[vault] pruned (keeping newest $VAULT_KEEP): $(echo "$removed" | tr '\n' ' ')"
    else
      log "[vault] nothing to prune (<= $VAULT_KEEP archives)"
    fi
    return 0
  fi
  if [ "$VAULT_OS" = "windows" ]; then
    removed=$(ssh $SSH_OPTS "$VAULT_SSH" "powershell -NoProfile -Command \"\$c=(Get-Date).AddDays(-$VAULT_RETENTION); Get-ChildItem '$(win_path)\\*.tar.zst' | Where-Object { \$_.LastWriteTime -lt \$c } | ForEach-Object { \$_.Name; Remove-Item \$_.FullName -Force }\"" 2>/dev/null | tr -d '\r')
  else
    removed=$(ssh $SSH_OPTS "$VAULT_SSH" "find '$VAULT_DIR' -maxdepth 1 -name '*.tar.zst' -mtime +$VAULT_RETENTION -print -delete" 2>/dev/null)
  fi
  if [ -n "$removed" ]; then
    log "[vault] pruned (older than ${VAULT_RETENTION}d): $(echo "$removed" | tr '\n' ' ')"
  else
    log "[vault] nothing to prune"
  fi
}

# ---------------------------------------------------------------- main ------
# TARGET is parsed and validated above, before the per-leg lock.
log "===== agent-snapshot ($TARGET) run $STAMP ====="
case "$TARGET" in
  snap)  [ "$SNAP_ENABLED" = true ] && backup_snap || log "[snap] disabled in conf" ;;
  vault) [ "$VAULT_ENABLED" = true ] && backup_vault || log "[vault] disabled in conf" ;;
  both)
    [ "$SNAP_ENABLED"  = true ] && backup_snap
    [ "$VAULT_ENABLED" = true ] && backup_vault
    ;;
  *) die "unknown target '$TARGET' (use: snap | vault | both)" ;;
esac

log "----- summary -----"
for r in ${RESULTS[@]+"${RESULTS[@]}"}; do log "  $r"; done
log "===== finished (rc=$RC) ====="
exit $RC
