#!/bin/bash
# snapshot-install — installs the agent-snapshot writer on the SOURCE machine.
#
#   snapshot-install --source DIR --snap-ssh TARGET --snap-dir PATH --snap-time HH:MM \
#                    [--snap-retention N] [--snap-min-free-gb N] \
#                    [--vault-ssh T --vault-os posix|windows --vault-dir P --vault-time HH:MM --vault-retention N] \
#                    [--no-schedule]
#
# What it does:
#   1. Copies bin/ and conf/ into ~/Library/Application Support/agent-snapshot/
#   2. Writes conf/snapshot.conf from your flags
#   3. Creates a DEDICATED ssh key (~/.ssh/id_ed25519_agent_snapshot) if missing
#   4. PRINTS the forced-command authorized_keys line for you (or your agent)
#      to append — this script never edits authorized_keys itself: your ssh
#      access may be load-bearing, and a bad edit can lock you out or break
#      other forced-command jobs. Append it yourself, deliberately.
#   5. Renders + loads the launchd schedule(s)
#   6. Tells you how to verify (probe) before trusting anything
#
# Single-machine mode: pass --snap-ssh localhost and attach both DAS drives to
# this machine. The same forced-command transport applies.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APPDIR="$HOME/Library/Application Support/agent-snapshot"
KEY="$HOME/.ssh/id_ed25519_agent_snapshot"

SRC="" SNAP_SSH="" SNAP_DIR="" SNAP_TIME=""
SNAP_RET=90 SNAP_FLOOR=50
VAULT_SSH="" VAULT_OS="posix" VAULT_DIR="" VAULT_TIME="" VAULT_RET=5
SCHEDULE=1

while [ $# -gt 0 ]; do
  case "$1" in
    --source) SRC="$2"; shift 2 ;;
    --snap-ssh) SNAP_SSH="$2"; shift 2 ;;
    --snap-dir) SNAP_DIR="$2"; shift 2 ;;
    --snap-time) SNAP_TIME="$2"; shift 2 ;;
    --snap-retention) SNAP_RET="$2"; shift 2 ;;
    --snap-min-free-gb) SNAP_FLOOR="$2"; shift 2 ;;
    --vault-ssh) VAULT_SSH="$2"; shift 2 ;;
    --vault-os) VAULT_OS="$2"; shift 2 ;;
    --vault-dir) VAULT_DIR="$2"; shift 2 ;;
    --vault-time) VAULT_TIME="$2"; shift 2 ;;
    --vault-retention) VAULT_RET="$2"; shift 2 ;;
    --no-schedule) SCHEDULE=0; shift ;;
    -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

[ -n "$SRC" ] && [ -n "$SNAP_SSH" ] && [ -n "$SNAP_DIR" ] || {
  echo "required: --source, --snap-ssh, --snap-dir (see --help)" >&2; exit 2; }
[ -d "$SRC" ] || { echo "source dir does not exist: $SRC" >&2; exit 2; }

echo "== 1/5 installing to $APPDIR"
mkdir -p "$APPDIR/bin" "$APPDIR/conf"
cp "$REPO/bin/snapshot" "$REPO/bin/snapshot-dispatch" "$APPDIR/bin/"
chmod +x "$APPDIR/bin/snapshot" "$APPDIR/bin/snapshot-dispatch"

echo "== 2/5 writing conf/snapshot.conf"
VE=false; [ -n "$VAULT_SSH" ] && VE=true
cat > "$APPDIR/conf/snapshot.conf" <<EOF
# agent-snapshot configuration — generated by snapshot-install $(date '+%Y-%m-%d')
SOURCE="$SRC"

SNAP_ENABLED=true
SNAP_SSH="$SNAP_SSH"
SNAP_DIR="$SNAP_DIR"
SNAP_RETENTION=$SNAP_RET
SNAP_MIN_FREE_GB=$SNAP_FLOOR

VAULT_ENABLED=$VE
VAULT_SSH="$VAULT_SSH"
VAULT_OS="$VAULT_OS"
VAULT_DIR="$VAULT_DIR"
VAULT_RETENTION=$VAULT_RET

STAGE="\$HOME/Library/Caches/agent-snapshot"
LOGDIR="\$HOME/Library/Logs/agent-snapshot"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"

EXCLUDES=(
  ".DS_Store"
  "target"
  ".build"
  "node_modules"
  "DerivedData"
  ".Spotlight-V100"
  ".fseventsd"
  ".TemporaryItems"
  ".DocumentRevisions-V100"
  ".Trashes"
)

REPLICA_KICK='nohup "\$HOME/Library/AgentSnapshot/mirror.sh" >/dev/null 2>&1 &'
EOF

echo "== 3/5 dedicated ssh key"
if [ ! -f "$KEY" ]; then
  ssh-keygen -t ed25519 -N "" -C "agent-snapshot" -f "$KEY" >/dev/null
  echo "   created $KEY"
else
  echo "   exists  $KEY"
fi

echo
echo "== 4/5 ACTION REQUIRED — append this ONE line to ~/.ssh/authorized_keys"
echo "   (append, never replace the file; other entries may be load-bearing):"
echo
printf 'restrict,command="/bin/bash '\''%s/bin/snapshot-dispatch'\''" %s\n' \
  "$APPDIR" "$(cat "$KEY.pub")"
echo
echo "   This script will NOT edit authorized_keys for you, by design."

if [ "$SCHEDULE" = 1 ]; then
  echo "== 5/5 launchd schedule(s)"
  render_plist() {  # render_plist <leg> <mode> <HH:MM>
    local leg="$1" mode="$2" hm="$3"
    local H="${hm%%:*}" M="${hm##*:}"
    local plist="$HOME/Library/LaunchAgents/com.agent-snapshot.$leg.plist"
    sed -e "s|__MODE__|$mode|g" -e "s|__HOUR__|${H#0}|g" -e "s|__MINUTE__|${M#0}|g" \
        -e "s|__HOME__|$HOME|g" -e "s|__LEG__|$leg|g" \
        "$REPO/launchd/com.agent-snapshot.leg.plist.template" > "$plist"
    launchctl bootout "gui/$(id -u)/com.agent-snapshot.$leg" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || launchctl load -w "$plist"
    echo "   $leg -> daily $hm ($plist)"
  }
  [ -n "$SNAP_TIME" ]  && render_plist snap  snap  "$SNAP_TIME"
  [ -n "$VAULT_TIME" ] && render_plist vault vault "$VAULT_TIME"
  [ -z "$SNAP_TIME$VAULT_TIME" ] && echo "   (no --snap-time/--vault-time given — nothing scheduled)"
else
  echo "== 5/5 scheduling skipped (--no-schedule)"
fi

cat <<'EOF'

== NEXT: verify before you trust it ==
 1. Grant sshd Full Disk Access (once):
      System Settings > Privacy & Security > Full Disk Access > enable sshd/Remote Login
    and enable Remote Login in System Settings > Sharing.
 2. Probe (read-only, proves the whole transport + source access):
      ssh -i ~/.ssh/id_ed25519_agent_snapshot -o IdentitiesOnly=yes localhost probe
    Expect: every T* = OK and "probe: OVERALL rc=0".
 3. First snapshot, on demand:
      ssh -i ~/.ssh/id_ed25519_agent_snapshot -o IdentitiesOnly=yes localhost snap
    Then confirm the dated directory exists on the archive host's DAS.
EOF
