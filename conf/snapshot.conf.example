# agent-snapshot configuration — sourced by bin/snapshot
# Copy to conf/snapshot.conf and edit. Everything about WHERE, WHEN and HOW MUCH
# lives here; the scripts hold no site details.

# --- What to back up ---------------------------------------------------------
# Any directory. The whole tree below it is protected (minus EXCLUDES).
SOURCE="$HOME/Desktop"

# --- Snap leg: dated hardlink snapshots on the archive host's DAS ------------
# Browsable, deduplicated history: each run creates a new dated directory;
# unchanged files are hardlinked against the previous snapshot and cost ~nothing.
SNAP_ENABLED=true
SNAP_SSH="user@archive-host.local"   # single-machine mode: SNAP_SSH="localhost"
# Optional second address for the same archive host, tried once at run start
# when SNAP_SSH is unreachable; the run then sticks with whichever answered.
# Typical pairing: a fixed LAN IP as SNAP_SSH (mDNS .local names can drop out
# mid-run and strand the post-rsync finalize) and the .local name here in case
# the IP moves. Make sure known_hosts holds the same host key for both.
SNAP_SSH_FALLBACK=""
SNAP_DIR="/Volumes/SnapArchive/snapshots"   # on the DAS, NOT the boot disk
                                     # MUST be <SNAP_PRIMARY>/snapshots: the archive
                                     # engine replicates only that directory
                                     # (absolute, or relative to the remote $HOME)
SNAP_RETENTION=90                    # days of snapshot history kept
                                     # NOTE: the archive host's mirror prunes at
                                     # PRUNE_AGE_DAYS (default 100, in engine.py).
                                     # Keep that ABOVE this value + margin — the
                                     # mirror must always outlive the primary.
SNAP_MIN_FREE_GB=50                  # abort/prune floor, measured on the DAS
# Publish SNAP_DIR/.changes/<stamp>.json after each incremental run (changed
# files, file count, bytes) — a hook for an archive-side fast replica path.
# The bundled engine does not read it; needs GNU rsync on the source. Costs one
# walk of the new snapshot on the archive host per run, so leave it off unless
# something consumes it.
SNAP_CHANGE_SIDECAR=false

# --- Vault leg: compressed, checksum-verified archives on a second host ------
# Independent second copy in a different format on different hardware.
VAULT_ENABLED=false
VAULT_SSH="user@vault-host"
VAULT_OS="posix"                     # posix | windows (hash + prune tooling differ)
VAULT_DIR="/backups/agent-snapshot"  # windows example: D:/agent-snapshot (drive letter required)
VAULT_KEEP=0                         # >0: keep the newest N archives (sorted by NAME,
                                     # immune to touched mtimes) and ignore VAULT_RETENTION
VAULT_RETENTION=5                    # days of archives kept when VAULT_KEEP=0
# Optional: refuse the upload unless the vault drive keeps this much free AFTER
# it lands (archive size + this floor). Set it whenever VAULT_DIR is on the
# host's OS drive. Unset = no check. An unreadable drive (missing, locked,
# unmounted) fails the leg with a clear reason instead of an opaque scp error.
#VAULT_MIN_FREE_GB=40

# --- Plumbing ----------------------------------------------------------------
STAGE="$HOME/Library/Caches/agent-snapshot"   # each leg locks + stages in $STAGE/<leg>/
LOGDIR="$HOME/Library/Logs/agent-snapshot"
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"

# Paths (relative to SOURCE root or bare names) excluded from every backup.
EXCLUDES=(
  ".DS_Store"
  # Build output is regenerable by rebuilding and compresses badly. Excluding it
  # keeps archives small; the files stay on disk so local rebuilds remain instant.
  "target"
  ".build"
  "node_modules"
  "DerivedData"
  ".Spotlight-V100"
  ".fseventsd"
  ".TemporaryItems"
  ".DocumentRevisions-V100"
  ".Trashes"
)

# --- Rate limiting (source forced-command dispatcher) ------------------------
# A holder of the writer forced-command key cannot delete history directly, but
# repeatedly triggering snap/both while free space sits below SNAP_MIN_FREE_GB
# forces prune_snap_to_fit() to drop the oldest snapshot once per completed run —
# an indirect but real retention bypass. snapshot-dispatch enforces these caps
# before bin/snapshot starts. probe is deliberately exempt (read-only, no prune
# path). The values are chosen so a human running a backup twice while testing
# is never denied; scheduled cadence is far looser than either window.
SNAP_RATE_BURST_COUNT=3              # max snap|vault|both triggers in the burst window
SNAP_RATE_BURST_WINDOW_SEC=600       # burst window (10 min)
SNAP_RATE_SUSTAIN_COUNT=2            # max snap|vault|both triggers in the sustain window
SNAP_RATE_SUSTAIN_WINDOW_SEC=3600    # sustain window (60 min)

# --- Key rotation (writer forced-command key) --------------------------------
# The dispatch key is generated once at install and would otherwise never expire.
# Scheduled rotation bounds leak exposure; the overlap window keeps the previous
# key valid while clients and authorized_keys catch up. Registry state and the
# stable symlink live under ~/.ssh/agent-snapshot/ (managed by snapshot-key-rotate).
KEY_ROTATION_ENABLED=true            # weekly rotate-if-due launchd job (when installed)
KEY_ROTATION_DAYS=90                 # rotate when the active key is older than this
KEY_OVERLAP_HOURS=72                 # previous key stays valid this long after rotation
# When true, the rotation job edits ~/.ssh/authorized_keys unattended — without
# this, keys age and print-only output rots on the operator's desk instead of
# rotating. Safety rails: timestamped backup before every edit, append-then-verify
# before flipping the stable symlink, probe-gated cutover with rollback on failure,
# and finalize removes only our exact-comment lines — never anyone else's forced-
# command entries. The one-time install authorized_keys line remains a manual human
# gate by design; only recurring rotation is automated.
KEY_ROTATION_APPLY_AK=true

# Optional: command run ON THE ARCHIVE HOST after a successful snapshot to start
# its replica pass (primary DAS -> mirror DAS) immediately instead of waiting
# for the archive host's own 5-minute poll. Empty string disables the kick.
# Contract: the entrypoint runs correctly with NO arguments (defaults to mirror).
# AGENT_SNAPSHOT_KICK=1 tells mirror.sh this is the legitimate writer kick, not a
# forced-command SSH trigger — the archive rate limiter exempts it and writes no
# history entry. Upgrading deployments must update this line when mirror.sh gains
# the rate gate; without the flag, post-snapshot kicks count as forced mirror
# traffic and can be denied during testing bursts.
REPLICA_KICK='AGENT_SNAPSHOT_KICK=1 nohup "$HOME/Library/AgentSnapshot/mirror.sh" >/dev/null 2>&1 &'
